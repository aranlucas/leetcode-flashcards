      "code": "class Solution {\n    public boolean containsDuplicate(int[] nums) {\n        // Use set to count duplicates\n        Set<Integer> counts = new HashSet();\n        \n        for (int num : nums) {\n            if (counts.contains(num)) {\n                return true;\n            }\n            counts.add(num);\n        }\n        return false;\n    }\n}"
