{
  "name": "mantine-next",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.2.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "analyze": "cross-env ANALYZE=true next build",
    "build": "next build",
    "dev": "concurrently --kill-others \"next dev\" \"pnpm netlify\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "netlify": "pnpm dlx netlify-cms-proxy-server",
    "postinstall": "prisma generate",
    "format": "oxfmt src content cron",
    "format:check": "oxfmt --check src content cron",
    "start": "next start",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@mantine/code-highlight": "^9.6.0",
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/modals": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@xstate/react": "^6.1.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.4.0",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "gray-matter": "^4.0.3",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "superjson": "^2.2.6",
    "supermemo": "^2.0.23",
    "xstate": "^5.32.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
